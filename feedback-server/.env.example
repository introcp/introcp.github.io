# Password required by GET /reset. Use a long random value.
FEEDBACK_PASSWORD=change-me

# Origins allowed to call the API from a browser (comma separated).
ALLOWED_ORIGINS=https://introcp.github.io,http://localhost:3500

# Limits (requests per minute). Votes are capped globally, not per IP, so a
# whole class behind one campus NAT IP can vote at once.
MAX_VOTES_PER_MINUTE=3000
RESETS_PER_MINUTE=10

# Where the tally is persisted inside the container.
STATE_FILE=/data/state.json

# Token of the remotely-managed Cloudflare tunnel for feedback.nosec.it
# (Cloudflare dashboard > Zero Trust > Networks > Tunnels). Compose interpolates
# it into the cloudflared command; keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=
