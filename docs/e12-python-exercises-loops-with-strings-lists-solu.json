 number to the 'fib_sequence' list\n        fib_sequence.append(next_fib)\n    \n    # Return the first 'n' numbers of the Fibonacci sequence (in case 'n' is less than 2)\n    return fib_sequence[:n]\n","visibility":"show","key":"DDifId06Rj"},{"type":"outputs","id":"OIxX6kuWKDa1U4I6WMGlP","children":[],"visibility":"show","key":"I9Bcg1CRdL"}],"visibility":"show","key":"C4IA7CnTYS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PwLfL08LLU"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-4","implicit":true,"key":"mC4PRZ9jWx"}],"key":"bCVRhTvegT"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"assert fibonacci(1) == [0]\nassert fibonacci(3) == [0,1,1]\nassert fibonacci(7) == [0, 1, 1, 2, 3, 5, 8]","visibility":"show","key":"uBwZwuZLMJ"},{"type":"outputs","id":"kmkXR9YDsbyb5WzfdHuAI","children":[],"visibility":"show","key":"UUnAU6xlgH"}],"visibility":"show","key":"Nj0frRkt1Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B0YmlBt9O4"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-5","implicit":true,"key":"ZLqs26tdxS"}],"key":"xhSOo0mydj"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Test case 2 (assert)","visibility":"show","key":"y3UoBgD7q6"},{"type":"outputs","id":"CSJQElu9vZVTlJysFc59c","children":[],"visibility":"show","key