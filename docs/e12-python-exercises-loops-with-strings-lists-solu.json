 number to the 'fib_sequence' list\n        fib_sequence.append(next_fib)\n    \n    # Return the first 'n' numbers of the Fibonacci sequence (in case 'n' is less than 2)\n    return fib_sequence[:n]\n","visibility":"show","key":"UX1zWNpd8j"},{"type":"outputs","id":"r9aOIPclMVfc02ozyDVF2","children":[],"visibility":"show","key":"XT7YcVD6ey"}],"visibility":"show","key":"dnJ5YOtnEn"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k2WyUafBC4"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-4","implicit":true,"key":"L3dmYTA2Ow"}],"key":"L5oPPPZs1P"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"assert fibonacci(1) == [0]\nassert fibonacci(3) == [0,1,1]\nassert fibonacci(7) == [0, 1, 1, 2, 3, 5, 8]","visibility":"show","key":"eRWAXuG2YD"},{"type":"outputs","id":"C11K9KF59YmOpJpF8atHF","children":[],"visibility":"show","key":"abPqdqtOwJ"}],"visibility":"show","key":"NUeSqpKhn3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vFi6NLqxYV"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-5","implicit":true,"key":"DgOMhRg5JE"}],"key":"Ud3U094rgk"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Test case 2 (assert)","visibility":"show","key":"Nj734302Zq"},{"type":"outputs","id":"jbmBhsyBcOIV5gqc8StHQ","children":[],"visibility":"show","key