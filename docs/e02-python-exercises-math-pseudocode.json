le":true,"value":"import math\n\ndef compound_interest(principal, rate, times_compounded, years):\n    # step 1: calculate the base of the exponentiation: (1 + rate / times_compounded)\n    # step 2: calculate the exponent: times_compounded * years\n    # step 3: use math.pow() to raise the base to the power of the exponent\n    # step 4: multiply the result by the principal amount\n    # step 5: return the final amount","visibility":"show","key":"Bl2184UjWr"},{"type":"outputs","id":"H_BNuWScC3-9Kn8ker5sV","children":[],"visibility":"show","key":"e8UluCc5vh"}],"visibility":"show","key":"f06cANjksZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"j2ALbI2x2r"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-4","implicit":true,"key":"KXvtIH7ges"}],"key":"kB5ecKAF4A"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Test the function with known values\n# $1000 at 5% compounded quarterly for 10 years should be approximately $1643.62\nresult = compound_interest(1000, 0.05, 4, 10)\nassert abs(result - 1643.62) < 0.1\n\n# Test with simple case: $100 at 10% compounded annually for 1 year should be $110\nresult = compound_interest(100, 0.10, 1, 1)\nassert abs(result - 110.0) < 0.01","visibility":"show","key":"Dkyjx70IRO"},{"type":"outputs","id":"ieQYt7xqlqWxZlS-npuz1","children":[],"visibility":"show","key":"c7jwW8o8GP"}],"visibility":"show","key":"vqz2xcVKjs"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"