ne":3,"column":1}},"key":"V3StrPAF9B"}],"key":"PqEpTcuqBQ"},{"type":"heading","depth":3,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Example 8: Comprehensive Error Handling","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cG77lJPwvG"}],"identifier":"example-8-comprehensive-error-handling","label":"Example 8: Comprehensive Error Handling","html_id":"example-8-comprehensive-error-handling","implicit":true,"key":"Dz7Mzp5vF4"}],"key":"Y9osigCgkN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\n\ndef get_weather_safe(city, api_key):\n    \"\"\"Fetch weather data with comprehensive error handling\"\"\"\n    url = 'https://api.openweathermap.org/data/2.5/weather'\n    \n    params = {\n        'q': city,\n        'appid': api_key,\n        'units': 'metric'\n    }\n    \n    try:\n        # Make GET request with timeout\n        response = requests.get(url, params=params, timeout=10)\n        \n        # Get status code\n        status_code = response.status_code\n        \n        # Handle different status codes\n        if status_code == 200:\n            # Success - parse data\n            try:\n                data = response.json()\n                return {\n                    'success': True,\n                    'error': None,\n                    'status_code': status_code,\n                    'data': {\n                        'city': data['name'],\n                        'temperature': data['main']['temp'],\n                        'description': data['weather'][0]['description']\n                    }\n                }\n            except (KeyError, ValueError):\n                return {\n                    'success': False,\n                    'error': 'Failed to parse API response',\n                    'status_code': status_code,\n                    'data': None\n                }\n        \n        elif status_code == 401:\n            return {\n                'success': False,\n                'error': 'Invalid API key. Please check your credentials.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 404:\n            return {\n                'success': False,\n                'error': f'City \"{city}\" not found. Please check the spelling.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 429:\n            return {\n                'success': False,\n                'error': 'Too many requests. Please wait and try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code >= 500:\n            return {\n                'success': False,\n                'error': 'Server error. Please try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        else:\n            return {\n                'success': False,\n                'error': f'Unexpected error (status code: {status_code})',\n                'status_code': status_code,\n                'data': None\n            }\n    \n    except requests.exceptions.Timeout:\n        return {\n            'success': False,\n            'error': 'Request timeout. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except requests.exceptions.ConnectionError:\n        return {\n            'success': False,\n            'error': 'Connection error. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except Exception as e:\n        return {\n            'success': False,\n            'error': f'Unexpected error: {str(e)}',\n            'status_code': None,\n            'data': None\n        }\n\n# Test with invalid API key (401 error)\nresult = get_weather_safe('London', 'invalid_api_key_12345')\nprint(f\"Success: {result['success']}\")\nprint(f\"Status Code: {result['status_code']}\")\nprint(f\"Error: {result['error']}\")","key":"omMqUIdlEm"},{"type":"outputs","id":"2N4ZH6SNf4M3Hcb6FNyDb","children":[],"key":"Y9y53DcGGt"}],"key":"XAAPbfbe4D"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"div","class":"alert alert-block alert-success","children":[{"type":"strong","children":[{"type":"text","value":"BEST PRACTICES","key":"PsVLNBf76C"}],"key":"HSbUC2HSBr"},{"type":"text","value":" for error handling:","key":"EeupzYAZLe"},{"type":"break","key":"zHdbNq9epM"},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Always check status codes before processing data","key":"dIKVc3akKK"}],"key":"mxZrCsjWx5"}],"key":"xiSDtJXoTA"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide user-friendly error messages","key":"DxMBAoIeGw"}],"key":"xUvJQnMxIs"}],"key":"W2JKhWEfeN"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Handle network errors (timeout, connection failures)","key":"PjrgbgnwRF"}],"key":"eZgMFlz4la"}],"key":"Bfa7DoP3DI"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Use try-except blocks for JSON parsing","key":"RmgEdlAhYT"}],"key":"T3yNPkX0n0"}],"key":"KMw7T9opZz"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Set timeouts for requests to prevent hanging","key":"Sf1ueHNCOJ"}],"key":"YBTroyNuHb"}],"key":"tiYNSK2FpJ"}],"key":"Ol817u0YGL"}],"key":"d7OeKb7c7T"