eating-data-with-post","implicit":true,"key":"TnQcGtOZZe"}],"key":"pUa8N1fWdw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import requests\n\ndef create_bin(data):\n    \"\"\"Create a JSON storage bin using JSONBin.io API\"\"\"\n    url = 'https://api.jsonbin.io/v3/b'\n    \n    # Set headers\n    headers = {\n        'Content-Type': 'application/json'\n    }\n    \n    try:\n        # Make POST request with JSON data\n        response = requests.post(url, json=data, headers=headers)\n        \n        # Check if successful\n        success = response.status_code in [200, 201]\n        \n        if success:\n            # Parse response\n            response_data = response.json()\n            \n            # Extract bin ID\n            bin_id = response_data['metadata']['id']\n            \n            # Build URL\n            bin_url = f'https://api.jsonbin.io/v3/b/{bin_id}'\n            \n            return {\n                'success': True,\n                'bin_id': bin_id,\n                'url': bin_url\n            }\n        else:\n            return {\n                'success': False,\n                'bin_id': None,\n                'url': None\n            }\n    \n    except:\n        return {\n            'success': False,\n            'bin_id': None,\n            'url': None\n        }\n\n# Test the function\ntest_data = {\n    'name': 'John Doe',\n    'age': 30,\n    'city': 'Rome'\n}\n\nresult = create_bin(test_data)\nprint(f\"Success: {result['success']}\")\nif result['success']:\n    print(f\"Bin ID: {result['bin_id']}\")\n    print(f\"URL: {result['url']}\")","key":"FLqpCnsDLg"},{"type":"outputs","id":"zCZlAoMSKwQ-J--sWJUiF","children":[],"key":"paelixm7Hh"}],"key":"QI22ifZUHZ"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"div","class":"alert alert-block alert-info","children":[{"type":"strong","children":[{"type":"tex