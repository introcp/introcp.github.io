its='metric'):\n    \"\"\"Get weather data for a city using Open-Meteo API\"\"\"\n    \n    # Step 1: Get coordinates for the city\n    geocoding_url = 'https://geocoding-api.open-meteo.com/v1/search'\n    geocoding_params = {\n        'name': city,\n        'count': 1\n    }\n    \n    geo_response = requests.get(geocoding_url, params=geocoding_params)\n    geo_data = geo_response.json()\n    \n    # Check if city was found\n    if 'results' not in geo_data or len(geo_data['results']) == 0:\n        return None\n    \n    # Extract coordinates\n    latitude = geo_data['results'][0]['latitude']\n    longitude = geo_data['results'][0]['longitude']\n    city_name = geo_data['results'][0]['name']\n    \n    # Step 2: Get weather data\n    weather_url = 'https://api.open-meteo.com/v1/forecast'\n    temp_unit = 'celsius' if units == 'metric' else 'fahrenheit'\n    \n    weather_params = {\n        'latitude': latitude,\n        'longitude': longitude,\n        'current_weather': 'true',\n        'temperature_unit': temp_unit\n    }\n    \n    weather_response = requests.get(weather_url, params=weather_params)\n    weather_data = weather_response.json()\n    \n    # Extract temperature\n    temperature = weather_data['current_weather']['temperature']\n    \n    return {\n        'city': city_name,\n        'temperature': temperature,\n        'units': units\n    }\n\n# Test the function\nweather = get_weather('Rome')\nif weather:\n    print(f\"City: {weather['city']}\")\n    print(f\"Temperature: {weather['temperature']}°C\")\n    print(f\"Units: {weather['units']}\")","key":"Zk6dn4Syyu"},{"type":"outputs","id":"LXxDGXJZ9tk89PqEq_-Sl","children":[],"key":"hTLZkSeqDu"}],"key":"HCGwRh5pfX"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}}