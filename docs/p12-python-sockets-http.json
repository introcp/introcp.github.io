      \n        elif status_code == 401:\n            return {\n                'success': False,\n                'error': 'Invalid API key. Please check your credentials.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 404:\n            return {\n                'success': False,\n                'error': f'City \"{city}\" not found. Please check the spelling.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 429:\n            return {\n                'success': False,\n                'error': 'Too many requests. Please wait and try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code >= 500:\n            return {\n                'success': False,\n                'error': 'Server error. Please try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        else:\n            return {\n                'success': False,\n                'error': f'Unexpected error (status code: {status_code})',\n                'status_code': status_code,\n                'data': None\n            }\n    \n    except requests.exceptions.Timeout:\n        return {\n            'success': False,\n            'error': 'Request timeout. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except requests.exceptions.ConnectionError:\n        return {\n            'success': False,\n            'error': 'Connection error. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except Exception as e:\n        return {\n            'success': False,\n            'error': f'Unexpected error: {str(e)}',\n            'status_code': None,\n            'data': None\n        }\n\n# Test with invalid API key (401 error)\nresult = get_weather_safe('London', 'invalid_api_key_12345')\nprint(f\"Success: {result['success']}\")\nprint(f\"Status Code: {result['status_code']}\")\nprint(f\"Error: {result['error']}\")","key":"ewnbNHQ6u9"},{"type":"outputs","id":"iZYzDmnY3ZVAfhLedcjW9","children":[],"key":"J6zagm1aXH"}],"key":"un0KMffbeD"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"div","class":"alert alert-block alert-success","children":[{"type":"strong","children":[{"type":"text","value":"BEST PRACTICES","key":"fIXjMobi0q"}],"key":"KKC3iRlcj6"},{"type":"text","value":" for error handling:","key":"b7tCFxdJoP"},{"type":"break","key":"aHpTO6Yvly"},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Always check status codes before processing data","key":"zALV3xmVaB"}],"key":"fjWkZCcSH1"}],"key":"fZ5wQzsAVY"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide user-friendly error messages","key":"vISp53c7X2"}],"key":"cVJ7nvjguV"}],"key":"JeJ8N0Mzx6"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Handle network errors (timeout, connection failures)","key":"JQO2k8G7Pw"}],"key":"IqoHKhinHe"}],"key":"hm2dllTJis"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Use try-except blocks for JSON parsing","key":"zOSO379sd0"}],"key":"T3wKCIdlS9"}],"key":"i7dvVh1QpT"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Set timeouts for requests to prevent hanging","key":"nR7rtIRdya"}],"key":"mq3s4HM3VW"}],"key":"KWYBALjQ8V"}],"key":"T9uYnJpQlM"}],"key":"CJamQ6R7aF"