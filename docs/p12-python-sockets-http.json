a = response.json()\n        \n        # Extract weather information\n        return {\n            'city': data['name'],\n            'temperature': data['main']['temp'],\n            'description': data['weather'][0]['description'],\n            'humidity': data['main']['humidity']\n        }\n    \n    except:\n        return None\n\nAPI_KEY = 'YOUR_OPENWEATHER_API_KEY_HERE'\n\nweather = get_weather_with_api_key('Rome', API_KEY)\nif weather:\n    print(f\"City: {weather['city']}\")\n    print(f\"Temperature: {weather['temperature']}°C\")\n    print(f\"Description: {weather['description']}\")\n    print(f\"Humidity: {weather['humidity']}%\")","key":"QSSXO2sapG"},{"type":"outputs","id":"hCzNnMjuMWZaEb-_1ulH2","children":[],"key":"y2u5dgQ0z1"}],"key":"QJdWlEEbaX"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"div","class":"alert alert-block alert-warning","children":[{"type":"strong","children":[{"type":"text","value":"SECURITY NOTE","key":"SxqBgEaorL"}],"key":"qVizJZZh6N"},{"type":"text","value":": Never hardcode API keys in your code!","key":"zstWvcrWi9"}],"key":"bMjufLxKnU"}],"key":"dsDaiVrJHF"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"SDKs: Even Higher-Level Abstractions","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mJVDhlFR8F"}],"identifier":"sdks-even-higher-level-abstractions","label":"SDKs: Even Higher-Level Abstractions","html_id":"sdks-even-higher-level-abstractions","implicit":true,"key":"aZKCclRkJ5"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Many popular web services provide ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TOkCyi5Sxf"},{"type":"strong","positi