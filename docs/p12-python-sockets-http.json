      \n        elif status_code == 401:\n            return {\n                'success': False,\n                'error': 'Invalid API key. Please check your credentials.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 404:\n            return {\n                'success': False,\n                'error': f'City \"{city}\" not found. Please check the spelling.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code == 429:\n            return {\n                'success': False,\n                'error': 'Too many requests. Please wait and try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        elif status_code >= 500:\n            return {\n                'success': False,\n                'error': 'Server error. Please try again later.',\n                'status_code': status_code,\n                'data': None\n            }\n        \n        else:\n            return {\n                'success': False,\n                'error': f'Unexpected error (status code: {status_code})',\n                'status_code': status_code,\n                'data': None\n            }\n    \n    except requests.exceptions.Timeout:\n        return {\n            'success': False,\n            'error': 'Request timeout. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except requests.exceptions.ConnectionError:\n        return {\n            'success': False,\n            'error': 'Connection error. Please check your internet connection.',\n            'status_code': None,\n            'data': None\n        }\n    \n    except Exception as e:\n        return {\n            'success': False,\n            'error': f'Unexpected error: {str(e)}',\n            'status_code': None,\n            'data': None\n        }\n\n# Test with invalid API key (401 error)\nresult = get_weather_safe('London', 'invalid_api_key_12345')\nprint(f\"Success: {result['success']}\")\nprint(f\"Status Code: {result['status_code']}\")\nprint(f\"Error: {result['error']}\")","key":"YpIS2n3KGx"},{"type":"outputs","id":"SYsOj1XtJPM6wV0RlBh8Z","children":[],"key":"Q26TAIioEZ"}],"key":"tVQXDTtNa4"},{"type":"block","kind":"notebook-content","data":{"slideshow":{"slide_type":"slide"}},"children":[{"type":"div","class":"alert alert-block alert-success","children":[{"type":"strong","children":[{"type":"text","value":"BEST PRACTICES","key":"DUkywlKgRf"}],"key":"BtUEIYZUAK"},{"type":"text","value":" for error handling:","key":"leF4KhHT13"},{"type":"break","key":"Xy5Ah84FYO"},{"type":"list","ordered":false,"start":null,"spread":false,"children":[{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Always check status codes before processing data","key":"j3SBSu5K5w"}],"key":"s9DJELMgKH"}],"key":"ypw6uYaZYV"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Provide user-friendly error messages","key":"y6i0iOqlxL"}],"key":"uxreubbzZs"}],"key":"unlVJXilKF"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Handle network errors (timeout, connection failures)","key":"vjJZrw2Wg5"}],"key":"KA8tJDTzrx"}],"key":"fPqde8iOyB"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Use try-except blocks for JSON parsing","key":"XaNreDD36X"}],"key":"KT3mc3JF82"}],"key":"nwgCTRDYYj"},{"type":"listItem","spread":false,"checked":null,"children":[{"type":"paragraph","children":[{"type":"text","value":"Set timeouts for requests to prevent hanging","key":"mnBFYgmubQ"}],"key":"GEgBx2MFR7"}],"key":"DMdcZfpEYD"}],"key":"wZRuV3QKC2"}],"key":"jAq6yZwrKl"