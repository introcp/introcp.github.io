imes_compounded, years):\n    amount = principal * math.pow(\n        (1 + rate / times_compounded), times_compounded * years\n    )\n    return amount\n\n# Test the function\nP = 1000  # Principal\nr = 0.05  # Annual interest rate (5%)\nn = 4  # Compounded quarterly\nt = 10  # Number of years\n\nfinal_amount = compound_interest(P, r, n, t)\nprint(f\"The final amount after {t} years is: {final_amount:.2f}\")","visibility":"show","key":"GDSYMQMtdS"},{"type":"outputs","id":"h-xe0nUYeSoPsJWVkQlZ8","children":[],"visibility":"show","key":"kVGUjFO7dz"}],"visibility":"show","key":"CMJrFguG8G"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RA4pnOkyBS"}],"identifier":"test-your-solution","label":"Test your solution","html_id":"test-your-solution-4","implicit":true,"key":"t49LDAETWZ"}],"key":"c3chIN0Kct"},{"type":"block","kind":"notebook-code","data":{"tags":["tests"]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Test the function with known values\n# $1000 at 5% compounded quarterly for 10 years should be approximately $1643.62\nresult = compound_interest(1000, 0.05, 4, 10)\nassert abs(result - 1643.62) < 0.1\n\n# Test with simple case: $100 at 10% compounded annually for 1 year should be $110\nresult = compound_interest(100, 0.10, 1, 1)\nassert abs(result - 110.0) < 0.01","visibility":"show","key":"B8TmTbUYr4"},{"type":"outputs","id":"jbySnsUGuLjKKq718q7Ck","children":[],"visibility":"show","key":"pmvSVvIB4u"}],"visibility":"show","key":"slmm7IomIT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Test your solution","position":{"start":{"line":1,"column":1},"end":{"line"